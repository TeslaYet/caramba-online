NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Used when the service role key is not set. Must match private.server_auth.
CARAMBA_DB_SECRET=
# Optional. Signs anonymous player cookies. Falls back to CARAMBA_DB_SECRET.
CARAMBA_SESSION_SECRET=

# Set to 1 only for local Playwright runs. Never enable in production.
CARAMBA_TEST_MODE=

# PUBLIC — publisher id, visible in the browser. Leave empty until AdSense is approved.
# A homemade cookie banner is not a Google-certified CMP. Enable Google Privacy & messaging
# before setting this in production. Format: ca-pub-1234567890123
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
# PUBLIC — numeric ad unit id from AdSense. Ads script stays off until this is set too.
NEXT_PUBLIC_ADSENSE_SLOT_ID=

# SECRET, server only. Never prefix these with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# SECRET, server only. The Premium price id. The browser cannot choose a price.
STRIPE_PRICE_ID=
# SERVER ONLY. Set to 1 only after Stripe Tax is activated on the Stripe account.
STRIPE_AUTOMATIC_TAX=
